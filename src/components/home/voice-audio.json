  "turns": [
    {
      "speaker": 0,
      "text": "Hi, uh, I'm calling about the two-bedroom apartment near the station. Is it still available?",
      "generation_id": "xBuJo62wT7977hLchd5a",
      "start": 0.0,
      "end": 5.24
    },
    {
      "speaker": 1,
      "text": "Yes, it is! What sort of budget did you have in mind?",
      "generation_id": "vpRv2R6kWCIT9DL5Z6ek",
      "start": 5.46,
      "end": 9.02
    },
    {
      "speaker": 0,
      "text": "Around twenty-five hundred a month. And, ideally, somewhere with a balcony.",
      "generation_id": "sKJApOC7adAmS6HsFYrV",
      "start": 9.24,
      "end": 14.3
    },
    {
      "speaker": 1,
      "text": "Then the place on Maple Street could be a good fit. Would you like to see it on Saturday at ten?",
      "generation_id": "Pgp1DvKpSjuWubA4P68H",
      "start": 14.52,
      "end": 19.37
    },
    {
      "speaker": 0,
      "text": "Yeah, that works. Can you text me the address?",
      "generation_id": "WxyAgXSfUq0B9TuOAu6A",
      "start": 19.59,
      "end": 22.56
    },
    {
      "speaker": 1,
      "text": "Of course. I'll send the address and viewing details to this number. See you Saturday!",
      "generation_id": "qODtryKISgDB6bC0kYy9",
      "start": 22.78,
      "end": 27.58
    }
  ],
